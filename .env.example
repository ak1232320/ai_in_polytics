# Qdrant Configuration
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_PATH=./qdrant_store
QDRANT_COLLECTION=spravedlivo_ru

# Embedding Model
EMB_MODEL=BAAI/bge-m3

# Retrieval Settings
TOP_K=6

# LLM Provider Settings
LLM_PROVIDER=openai
LLM_EXPECT_JSON=true

# OpenAI Configuration (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-api-key-here

# OpenRouter Configuration (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REFERER=
OPENROUTER_TITLE=

# LLM Model Settings
# OpenAI example: gpt-4o-mini
# OpenRouter example: openai/gpt-4o-mini
LLM_MODEL=gpt-4o-mini
LLM_TEMP=1
