# Qdrant Configuration
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_PATH=./qdrant_store
QDRANT_COLLECTION=spravedlivo_ru

# Embedding Model
EMB_MODEL=BAAI/bge-m3

# Retrieval Settings
TOP_K=6

# RAG Toggle (set to false to disable RAG, only LLM will be used)
USE_RAG=true

# OpenAI Configuration
OPENAI_API_KEY=your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMP=1
